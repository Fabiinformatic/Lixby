rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function accountNumberFields() {
      return ["accountNumber", "accountNumberCreatedAt"];
    }

    function optionalStringField(key, maxLength) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is string
          && request.resource.data[key].size() <= maxLength);
    }

    function optionalBooleanField(key) {
      return !(key in request.resource.data)
        || request.resource.data[key] is bool;
    }

    function validUpdatedAt() {
      return "updatedAt" in request.resource.data
        && request.resource.data.updatedAt is timestamp;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          "address", "adsOptIn", "birthDate", "city", "country",
          "countryContact", "email", "firstName", "language", "lastName",
          "phone", "photoUrl", "postalCode", "prefAds", "prefNews",
          "prefOffers", "prefSupport", "prefUpdates", "timezone", "updatedAt"
        ])
        && optionalStringField("address", 200)
        && optionalStringField("birthDate", 20)
        && optionalStringField("city", 100)
        && optionalStringField("country", 100)
        && optionalStringField("countryContact", 100)
        && optionalStringField("email", 254)
        && optionalStringField("firstName", 100)
        && optionalStringField("language", 35)
        && optionalStringField("lastName", 100)
        && optionalStringField("phone", 32)
        && optionalStringField("photoUrl", 2048)
        && (!("photoUrl" in request.resource.data)
          || request.resource.data.photoUrl == ""
          || request.resource.data.photoUrl.matches("^https://.*$"))
        && optionalStringField("postalCode", 20)
        && optionalBooleanField("adsOptIn")
        && optionalBooleanField("prefAds")
        && optionalBooleanField("prefNews")
        && optionalBooleanField("prefOffers")
        && optionalBooleanField("prefSupport")
        && optionalBooleanField("prefUpdates")
        && optionalStringField("timezone", 100)
        && validUpdatedAt();
    }

    function validBilling() {
      return request.resource.data.keys().hasOnly([
          "address", "city", "country", "name", "postalCode", "updatedAt"
        ])
        && optionalStringField("address", 200)
        && optionalStringField("city", 100)
        && optionalStringField("country", 100)
        && optionalStringField("name", 100)
        && optionalStringField("postalCode", 20)
        && validUpdatedAt();
    }

    // ==== Comunidad Lixby: helpers ====
    function hasRole(roles) {
      return signedIn() && request.auth.token.get('role', '') in roles;
    }

    function realUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isMod() {
      return hasRole(['owner', 'mod', 'admin']);
    }

    function postIsPublished(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return exists(postPath) && get(postPath).data.status == "published";
    }

    function commentIsPublished(postId, commentId) {
      let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
      return exists(commentPath) && get(commentPath).data.status == "published";
    }

    function optionalReportString(key, maxLength) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is string
          && request.resource.data[key].size() <= maxLength);
    }

    // Solo "me gusta" (value == 1): la UI no tiene voto negativo. Los triggers
    // siguen tolerando -1 por si en el futuro se reactivan los downvotes.
    function validVote() {
      return request.resource.data.keys().hasOnly(['value', 'createdAt'])
        && request.resource.data.value == 1
        && request.resource.data.createdAt == request.time;
    }

    function validReport() {
      return realUser()
        && request.resource.data.keys().hasOnly([
          'targetType', 'targetPath', 'targetId', 'targetAuthorUid',
          'reporterUid', 'reason', 'note', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment']
        && request.resource.data.reason in ['spam', 'abuse', 'illegal', 'off-topic', 'other']
        && optionalReportString('targetPath', 512)
        && optionalReportString('targetId', 128)
        && optionalReportString('targetAuthorUid', 128)
        && optionalReportString('note', 1000)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(accountNumberFields());
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(accountNumberFields());

      match /account/profile {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProfile();
      }

      match /account/billing {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBilling();
      }

      // Sesiones activas: cada navegador registra y actualiza la suya. El dueño
      // puede leer, crear, actualizar (revokedAt / lastActiveAt) y borrar.
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid)
          && (!('revokedAt' in resource.data)
            || resource.data.revokedAt == null
            || request.resource.data.get('revokedAt', null) == resource.data.revokedAt);
        allow delete: if isOwner(uid);
      }

      // Historial de inicio de sesión: solo se puede crear (con la forma exacta)
      // y leer; no se puede editar ni borrar (queda como registro permanente).
      match /loginHistory/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['browser', 'os', 'tipo', 'method', 'createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /accountNumbers/{accountNumber} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // =====================================================================
    // Comunidad Lixby (/es/comunidad) — BORRADOR v1 (aún NO desplegado)
    //
    // Lectura directa desde el cliente. La escritura de contenido sensible
    // (hilos, comentarios, moderación) se hace vía Cloud Functions con el
    // Admin SDK, que ignora estas reglas. Los votos SÍ se escriben desde el
    // cliente (id de documento = uid) y los contadores los mantienen los
    // triggers de Cloud Functions (campos server-only).
    // =====================================================================

    // Espacios / subforos: LixBuds, Lixney, Lixfly, General, Ideas, Soporte.
    match /spaces/{spaceId} {
      allow read: if true;      // catálogo público (SEO)
      allow write: if hasRole(['owner', 'admin']);  // sólo owner/admin
    }

    // Hilos (posts)
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isMod();
      allow create, update, delete: if false;  // vía Cloud Functions
    }

    // Comentarios anidados (subcolección de cada hilo). El cliente NO lee
    // comentarios directamente (los pinta el SSR); la lectura abierta dejaba
    // que cualquiera leyera con un cliente de Firestore un comentario retirado
    // por moderación. Ahora solo lo ven publicados (o los moderadores).
    match /posts/{postId}/comments/{commentId} {
      allow read: if resource.data.status == "published" || isMod();
      allow write: if false; // vía Cloud Functions
    }

    // Votos de hilo. El id del documento es el uid => un voto por usuario.
    match /posts/{postId}/votes/{voteUid} {
      allow read: if isOwner(voteUid);
      allow create, update: if realUser()
        && isOwner(voteUid)
        && validVote()
        && postIsPublished(postId);
      allow delete: if isOwner(voteUid);
    }

    // Votos de comentario. Mismo esquema.
    match /posts/{postId}/comments/{commentId}/votes/{voteUid} {
      allow read: if isOwner(voteUid);
      allow create, update: if realUser()
        && isOwner(voteUid)
        && validVote()
        && commentIsPublished(postId, commentId);
      allow delete: if isOwner(voteUid);
    }

    // Estadísticas de hilo (visitas). Solo escritura del servidor (el callable
    // communityTrackView usa el Admin SDK, que ignora estas reglas).
    match /postStats/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Perfil público (proyección). Separado de users/{uid}, que es privado.
    match /profiles/{profileUid} {
      allow read: if true;
      allow write: if false;  // contadores y datos: sólo servidor
    }

    // Reportes de contenido (para el panel de moderación)
    match /reports/{reportId} {
      allow create: if validReport();
      allow read, update, delete: if isMod();
    }

    // Registro de moderación (quién hizo qué, sin contenido). Solo escritura
    // del servidor vía Admin SDK; solo lectura de moderadores.
    match /moderationLog/{entryId} {
      allow read: if isMod();
      allow write: if false;
    }

    // Colecciones internas: nunca legibles ni escribibles desde el cliente.
    // (Redundantes con el catch-all de abajo, pero explícitas para que una
    // revisión o una prueba de reglas lo vea sin tener que deducirlo.)
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /moderationStats/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
